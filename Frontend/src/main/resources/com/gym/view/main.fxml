<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.gym.controller.MainController"
            styleClass="app-shell">

    <left>
        <VBox prefWidth="240"
              styleClass="sidebar"
              spacing="8">

            <HBox styleClass="brand" spacing="10">
                <Label text="●" styleClass="brand-mark"/>

                <VBox>
                    <Label text="FITCLUB" styleClass="brand-name"/>
                    <Label text="GESTIÓN DEPORTIVA"
                           styleClass="brand-caption"/>
                </VBox>
            </HBox>

            <Label text="MENÚ PRINCIPAL"
                   styleClass="menu-caption"/>

            <Button text="⌂   Dashboard"
                    onAction="#goDashboard"
                    styleClass="sidebar-button"/>

            <Button text="♙   Socios"
                    onAction="#goSocios"
                    styleClass="sidebar-button"/>

            <Button text="💰   Pagos"
                    onAction="#goPagos"
                    styleClass="sidebar-button"/>

            <Button text="!   Pendientes"
                    onAction="#goPendientes"
                    styleClass="sidebar-button"/>

            <Region VBox.vgrow="ALWAYS"/>

            <Button text="⚙   Configuración"
                    styleClass="sidebar-button muted"/>

            <HBox styleClass="profile" spacing="10">
                <Label text="MG" styleClass="avatar"/>

                <VBox>
                    <Label text="María González"
                           styleClass="profile-name"/>
                    <Label text="Administrador"
                           styleClass="profile-role"/>
                </VBox>
            </HBox>

        </VBox>
    </left>

    <center>
        <BorderPane styleClass="main-area">

            <top>
                <HBox styleClass="topbar"
                      alignment="CENTER_LEFT"
                      spacing="15">

                    <VBox HBox.hgrow="ALWAYS">
                        <Label text="Panel de control"
                               styleClass="topbar-kicker"/>

                        <Label fx:id="pageHeading"
                               text="Resumen general"
                               styleClass="topbar-title"/>
                    </VBox>

                    <Label text="Hoy, 10 septiembre 2026"
                           styleClass="topbar-date"/>

                    <Label text="MG"
                           styleClass="avatar small"/>

                </HBox>
            </top>

            <center>
                <StackPane fx:id="contentPane"
                           styleClass="content-area"/>
            </center>

        </BorderPane>
    </center>

</BorderPane>