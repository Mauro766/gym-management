<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.gym.controller.NuevoSocioController" spacing="22" styleClass="page"><VBox><Label text="Nuevo socio" styleClass="page-title"/><Label text="Completa los datos para registrar un nuevo miembro." styleClass="page-subtitle"/></VBox><VBox maxWidth="760" spacing="18" styleClass="form-panel"><GridPane hgap="18" vgap="16"><columnConstraints><ColumnConstraints hgrow="ALWAYS"/><ColumnConstraints hgrow="ALWAYS"/></columnConstraints><VBox spacing="7" GridPane.columnIndex="0"><Label text="Nombre" styleClass="field-label"/><TextField fx:id="nameField" promptText="Ej. María"/></VBox><VBox spacing="7" GridPane.columnIndex="1"><Label text="Apellido" styleClass="field-label"/><TextField fx:id="lastNameField" promptText="Ej. González"/></VBox><VBox spacing="7" GridPane.rowIndex="1"><Label text="DNI" styleClass="field-label"/><TextField fx:id="dniField" promptText="Sin puntos"/></VBox><VBox spacing="7" GridPane.columnIndex="1" GridPane.rowIndex="1"><Label text="Teléfono" styleClass="field-label"/><TextField fx:id="phoneField" promptText="11 0000-0000"/></VBox><VBox spacing="7" GridPane.rowIndex="2"><Label text="Email" styleClass="field-label"/><TextField fx:id="emailField" promptText="correo@ejemplo.com"/></VBox><VBox spacing="7" GridPane.columnIndex="1" GridPane.rowIndex="2"><Label text="Fecha de alta" styleClass="field-label"/><DatePicker fx:id="datePicker"/></VBox></GridPane><Separator/><HBox alignment="CENTER_RIGHT" spacing="10"><Button text="Cancelar" onAction="#cancel" styleClass="secondary-button"/><Button text="Guardar socio" onAction="#save" styleClass="primary-button"/></HBox></VBox></VBox>